{
  "name": "dunesight",
  "private": true,
  "version": "0.0.1",
  "description": "DuneSight: a 3D globe that tracks sand-dune migration west of Al Ain from NASA Landsat, HLS, MERRA-2 and NASADEM data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "placeholders": "pipeline/.venv/bin/python pipeline/make_placeholders.py",
    "pipeline": "pipeline/.venv/bin/python pipeline/run_pipeline.py",
    "test:e2e": "npm run build && npm run test:e2e:dev && npm run test:e2e:prod",
    "test:e2e:dev": "E2E_TARGET=dev playwright test",
    "test:e2e:prod": "E2E_TARGET=prod playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cesium": "^1.147.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.8",
    "vite-plugin-cesium": "^1.2.23"
  }
}
